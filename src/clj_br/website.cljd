(ns clj-br.website
  (:require
    ["package:flutter/material.dart" :as m]
    ["package:flutter/widgets.dart" :as w]
    ["dart:async" :as async]
    ["dart:html" :as dom]
    ["dart:ui_web" :as ui-web]
    [cljd.flutter :as f]
    [sci.core :as sci]))

(def counter-cljd-state
  "A host-created (real ClojureDart) atom, dedicated to the ClojureDart
   widget mode's Counter sample. Atoms created *inside* the vendored SCI
   sandbox (e.g. via `(state/atom 0)`) don't work correctly with
   `f/widget`'s `:watch` in this ClojureDart-widget world -- only
   host-created atoms passed in from the outside do. The real
   Scittle+Reagent+React runtime used by the Hiccup/Reagent tab is a
   separate JS interpreter and isn't affected by this; samples there can
   freely create their own `(r/atom ...)`."
  (atom 0))

(def todo-cljd-state
  (atom [{:text "Entrar no Telegram" :done true}
         {:text "Participar do Discord" :done false}
         {:text "Assistir o canal" :done false}]))

(def todo-cljd-draft
  (atom ""))

(def todo-cljd-draft-controller
  (m/TextEditingController))

(defn add-todo-cljd-io! []
  (let [text @todo-cljd-draft]
    (when (seq text)
      (swap! todo-cljd-state conj {:text text :done false})
      (reset! todo-cljd-draft "")
      (set! (.-text ^m/TextEditingController todo-cljd-draft-controller) ""))))

(defn callback [{:keys [handler pass-value?]}]
  (when handler
    (if pass-value?
      (fn [value]
        (handler value))
      (fn []
        (handler)))))

(def site-model
  {:title    "Clojure Brasil"
   :subtitle "Comunidade brasileira de Clojure"
   :logo     "resources/logo.png"
   :links    [{:titulo "Grupo no Clojurians"
               :href   "https://join.slack.com/t/clojurians/shared_invite/zt-zjqnhvdj-HSQGSyA79T5qdMb9GwqD1A"}
              {:title "Grupo no Telegram"
               :href  "https://t.me/clojurebrasil"}
              {:title "Servidor do Discord"
               :href  "https://discord.gg/UTxeA9tHnd"}
              {:title "Canal no YouTube"
               :href  "https://www.youtube.com/@clojure-br"}
              {:title "Meetup"
               :href  "https://www.meetup.com/clojure-br/"}
              {:title "Duvidas e discussoes"
               :href  "https://github.com/clj-br/forum/discussions"}
              {:title "Vagas e oportunidades"
               :href  "https://github.com/clj-br/vagas"}]})

(defn value-widget [value]
  (cond
    (instance? m/Widget value)
    value

    :else
    (m/Text (pr-str value)
      .style (m/TextStyle .fontSize 14.0
               .color m/Colors.black54))))

(declare flutter-link)

(defn community-site-widget
  "Styled to look like the plain, unstyled markup of clojurebrasil.com.br
   (black serif-weight title, default-blue underlined links, no href
   subtitle line), so this native widget and the real Reagent tab read as
   the same page rather than two different-looking apps."
  [{:keys [title logo links]}]
  (m/Column
    .mainAxisSize m/MainAxisSize.min
    .crossAxisAlignment m/CrossAxisAlignment.center
    .children
    [(m/Image .image (m/AssetImage logo) .height 112.0)
     (m/SizedBox .height 12.0)
     (m/Text title
       .textAlign m/TextAlign.center
       .style (m/TextStyle .fontSize 34.0
                .fontWeight m/FontWeight.bold
                .color m/Colors.black))
     (m/SizedBox .height 20.0)
     (m/Column
       .mainAxisSize m/MainAxisSize.min
       .crossAxisAlignment m/CrossAxisAlignment.center
       .children (vec (map flutter-link links)))]))

(defn community-hiccup-widget [model]
  (community-site-widget model))

(defn flutter-link [{:keys [title]}]
  (m/Padding
    .padding (m/EdgeInsets.symmetric .vertical 8.0)
    .child
    (m/Text title
      .textAlign m/TextAlign.center
      .style (m/TextStyle .fontSize 16.0
               .color m/Colors.blue
               .decoration m/TextDecoration.underline))))

(defn community-flutter-widget
  "A native ClojureDart Flutter component for the same site model."
  [model]
  (community-site-widget model))

