(ns repl.app
  (:require ["package:flutter/material.dart" :as m]
            ["package:flutter_html/flutter_html.dart" :as html]
            [cljd.flutter :as f]
            [clojure.string :as str]
            [sci.core :as sci]))

(def site-model
  {:title "Clojure Brasil"
   :subtitle "Comunidade brasileira de Clojure"
   :logo "resources/logo.png"
   :links [{:title "Grupo no Telegram"
            :href "https://t.me/clojurebrasil"}
           {:title "Servidor do Discord"
            :href "https://discord.gg/UTxeA9tHnd"}
           {:title "Canal no YouTube"
            :href "https://www.youtube.com/@clojure-br"}
           {:title "Meetup"
            :href "https://www.meetup.com/clojure-br/"}
           {:title "Duvidas e discussoes"
            :href "https://github.com/clj-br/forum/discussions"}
           {:title "Vagas e oportunidades"
            :href "https://github.com/clj-br/vagas"}]})

(defn escape-html [s]
  (-> (str s)
      (str/replace "&" "&amp;")
      (str/replace "<" "&lt;")
      (str/replace ">" "&gt;")
      (str/replace "\"" "&quot;")
      (str/replace "'" "&#39;")))

(defn style->html [style]
  (when (seq style)
    (str/join "; "
              (for [[k v] style]
                (str (name k) ": " v)))))

(defn attrs->html [attrs]
  (apply str
         (for [[k v] attrs
               :let [v (if (= k :style) (style->html v) v)]
               :when (some? v)]
           (str " " (name k) "=\"" (escape-html v) "\""))))

(declare hiccup->html)

(defn node->html [node]
  (cond
    (nil? node) ""
    (string? node) (escape-html node)
    (number? node) (str node)
    (keyword? node) (name node)
    (seq? node) (apply str (map node->html node))
    (vector? node) (hiccup->html node)
    :else (escape-html node)))

(defn hiccup->html [node]
  (let [[tag maybe-attrs & children] node
        attrs (if (map? maybe-attrs) maybe-attrs {})
        children (if (map? maybe-attrs) children (cons maybe-attrs children))]
    (str "<" (name tag) (attrs->html attrs) ">"
         (apply str (map node->html children))
         "</" (name tag) ">")))

(defn community-hiccup
  "A Reagent-compatible Hiccup component for the same site model."
  [{:keys [title subtitle logo links]}]
  [:section {:style {:font-family "system-ui, -apple-system, sans-serif"
                     :text-align "center"
                     :padding "24px"
                     :color "#222"}}
   [:img {:src (str "assets/" logo)
          :alt "Clojure Brasil"
          :style {:height "112px"
                  :margin-bottom "12px"}}]
   [:h1 {:style {:font-size "34px"
                 :margin "8px 0"}} title]
   [:p {:style {:font-size "18px"
                :margin "0 0 20px 0"
                :color "#4d4d4d"}} subtitle]
   [:ul {:style {:list-style "none"
                 :padding "0"
                 :margin "0"}}
    (for [{:keys [title href]} links]
      [:li {:style {:margin "10px 0"}}
       [:a {:href href
            :style {:color "#1793d1"
                    :font-size "17px"
                    :text-decoration "none"}}
        title]])]])

(defn community-hiccup-widget [model]
  (html/Html .data (hiccup->html (community-hiccup model))))

(defn flutter-link [{:keys [title href]}]
  (m/Container
   .margin (m/EdgeInsets.symmetric .vertical 5.0)
   .child
   (m/Column
    .mainAxisSize m/MainAxisSize.min
    .children
    [(m/Text title
             .textAlign m/TextAlign.center
             .style (m/TextStyle .fontSize 17.0
                                 .fontWeight m/FontWeight.w600
                                 .color (m/Color 0xFF1793D1)))
     (m/Text href
             .textAlign m/TextAlign.center
             .style (m/TextStyle .fontSize 12.0
                                 .color m/Colors.black54))])))

(defn community-flutter-widget
  "A native ClojureDart Flutter component for the same site model."
  [{:keys [title subtitle logo links]}]
  (m/Column
   .mainAxisSize m/MainAxisSize.min
   .crossAxisAlignment m/CrossAxisAlignment.center
   .children
   (vec
    (concat
     [(m/Image .image (m/AssetImage logo) .height 112.0)
      (m/SizedBox .height 12.0)
      (m/Text title
              .textAlign m/TextAlign.center
              .style (m/TextStyle .fontSize 34.0
                                  .fontWeight m/FontWeight.bold
                                  .color (m/Color 0xFF222222)))
      (m/SizedBox .height 8.0)
      (m/Text subtitle
              .textAlign m/TextAlign.center
              .style (m/TextStyle .fontSize 18.0
                                  .color (m/Color 0xFF4D4D4D)))
      (m/SizedBox .height 20.0)]
     (map flutter-link links)))))

(def site-hiccup-source
  "(ns runtime
  (:require [clj-br.site :as site]))

(let [{:keys [title subtitle logo links]} site/model]
  [:section {:style {:font-family \"system-ui, -apple-system, sans-serif\"
                     :text-align \"center\"
                     :padding \"24px\"
                     :color \"#222\"}}
   [:img {:src (str \"assets/\" logo)
          :alt title
          :style {:height \"112px\"
                  :margin-bottom \"12px\"}}]
   [:h1 {:style {:font-size \"34px\"
                 :margin \"8px 0\"}}
    title]
   [:p {:style {:font-size \"18px\"
                :margin \"0 0 20px 0\"
                :color \"#4d4d4d\"}}
    subtitle]
   [:ul {:style {:list-style \"none\"
                 :padding \"0\"
                 :margin \"0\"}}
    (for [{:keys [title href]} links]
      [:li {:style {:margin \"10px 0\"}}
       [:a {:href href
            :style {:color \"#1793d1\"
                    :font-size \"17px\"
                    :text-decoration \"none\"}}
        title]])]])
")

(def site-cljd-source
  "(ns runtime
  (:require [\"package:flutter/material.dart\" :as m]
            [clj-br.site :as site]))

(let [{:keys [title subtitle logo links]} site/model
      link-view (fn [{:keys [title href]}]
                  (m/Container
                   .margin (m/EdgeInsets.symmetric .vertical 5.0)
                   .child
                   (m/Column
                    .mainAxisSize m/MainAxisSize.min
                    .children
                    [(m/Text title
                             .textAlign m/TextAlign.center
                             .style (m/TextStyle
                                     .fontSize 17.0
                                     .fontWeight m/FontWeight.w600
                                     .color (m/Color 0xFF1793D1)))
                     (m/Text href
                             .textAlign m/TextAlign.center
                             .style (m/TextStyle
                                     .fontSize 12.0
                                     .color m/Colors.black54))])))]
  (m/Column
   .mainAxisSize m/MainAxisSize.min
   .crossAxisAlignment m/CrossAxisAlignment.center
   .children
   (vec
    (concat
     [(m/Image .image (m/AssetImage logo) .height 112.0)
      (m/SizedBox .height 12.0)
      (m/Text title
              .textAlign m/TextAlign.center
              .style (m/TextStyle
                      .fontSize 34.0
                      .fontWeight m/FontWeight.bold
                      .color (m/Color 0xFF222222)))
      (m/SizedBox .height 8.0)
      (m/Text subtitle
              .textAlign m/TextAlign.center
              .style (m/TextStyle
                      .fontSize 18.0
                      .color (m/Color 0xFF4D4D4D)))
      (m/SizedBox .height 20.0)]
     (map link-view links)))))
")

(def counter-hiccup-source
  "(ns runtime)

(let [value 6]
  [:section {:style {:font-family \"system-ui, -apple-system, sans-serif\"
                     :text-align \"center\"
                     :padding \"24px\"}}
   [:h1 {:style {:font-size \"30px\"
                 :margin \"0 0 18px 0\"}}
    \"Counter\"]
   [:p {:style {:font-size \"16px\"
                :color \"#4d4d4d\"}}
    \"Declarative Hiccup/Reagent shape\"]
   [:div {:style {:font-size \"54px\"
                  :font-weight \"700\"
                  :margin \"18px 0\"}}
    value]
   [:button {:style {:border \"1px solid #1793d1\"
                     :border-radius \"6px\"
                     :background \"#e8f4fb\"
                     :color \"#1793d1\"
                     :padding \"10px 16px\"}}
    \"increment\"]])
")

(def counter-cljd-source
  "(ns runtime
  (:require [\"package:flutter/material.dart\" :as m]
            [cljd.flutter :as f]))

(defonce counter (atom 0))

(f/watch counter [value]
  (m/Column
   .mainAxisSize m/MainAxisSize.min
   .crossAxisAlignment m/CrossAxisAlignment.center
   .children
   [(m/Text \"Counter\"
            .textAlign m/TextAlign.center
            .style (m/TextStyle
                    .fontSize 30.0
                    .fontWeight m/FontWeight.bold
                    .color (m/Color 0xFF222222)))
    (m/SizedBox .height 10.0)
    (m/Text \"Interactive ClojureDart widget shape\"
            .textAlign m/TextAlign.center
            .style (m/TextStyle
                    .fontSize 16.0
                    .color m/Colors.black54))
    (m/SizedBox .height 18.0)
    (m/Text (str value)
            .textAlign m/TextAlign.center
            .style (m/TextStyle
                    .fontSize 54.0
                    .fontWeight m/FontWeight.bold
                    .color (m/Color 0xFF1793D1)))
    (m/SizedBox .height 18.0)
    (m/ElevatedButton
     .onPressed (fn [] (swap! counter inc))
     .child (m/Text \"increment\"))]))
")

(def todo-hiccup-source
  "(ns runtime)

(let [todos [{:text \"Entrar no Telegram\" :done true}
             {:text \"Participar do Discord\" :done false}
             {:text \"Assistir o canal\" :done false}]]
  [:section {:style {:font-family \"system-ui, -apple-system, sans-serif\"
                     :padding \"24px\"
                     :color \"#222\"}}
   [:h1 {:style {:font-size \"30px\"
                 :text-align \"center\"
                 :margin \"0 0 18px 0\"}}
    \"Todo list\"]
   [:ul {:style {:list-style \"none\"
                 :padding \"0\"
                 :margin \"0\"}}
    (for [{:keys [text done]} todos]
      [:li {:style {:display \"flex\"
                    :gap \"10px\"
                    :align-items \"center\"
                    :padding \"8px 0\"}}
       [:input {:type \"checkbox\"
                :checked done
                :disabled true}]
       [:span {:style {:text-decoration (when done \"line-through\")
                       :color (if done \"#667085\" \"#222\")}}
        text]])]])
")

(def todo-cljd-source
  "(ns runtime
  (:require [\"package:flutter/material.dart\" :as m]))

(let [todos [{:text \"Entrar no Telegram\" :done true}
             {:text \"Participar do Discord\" :done false}
             {:text \"Assistir o canal\" :done false}]
      todo-row (fn [{:keys [text done]}]
                 (m/Row
                  .children
                  [(m/Checkbox .value done .onChanged nil)
                   (m/SizedBox .width 8.0)
                   (m/Text text
                           .style (m/TextStyle
                                   .fontSize 16.0
                                   .color (if done
                                            (m/Color 0xFF667085)
                                            (m/Color 0xFF222222))))]))]
  (m/Column
   .mainAxisSize m/MainAxisSize.min
   .crossAxisAlignment m/CrossAxisAlignment.stretch
   .children
   (vec
    (concat
     [(m/Text \"Todo list\"
              .textAlign m/TextAlign.center
              .style (m/TextStyle
                      .fontSize 30.0
                      .fontWeight m/FontWeight.bold
                      .color (m/Color 0xFF222222)))
      (m/SizedBox .height 18.0)]
     (map todo-row todos)))))
")

(def samples
  {:site {:label "Site"
          :hiccup site-hiccup-source
          :cljd site-cljd-source}
   :counter {:label "Counter"
             :hiccup counter-hiccup-source
             :cljd counter-cljd-source}
   :todo {:label "Todo list"
          :hiccup todo-hiccup-source
          :cljd todo-cljd-source}})

(def sample-order [:site :counter :todo])

(defn source-for [sample mode]
  (get-in samples [sample mode]))

(defn hiccup-mode? [mode]
  (= mode :hiccup))

(defn eval-source [ctx source]
  (try
    {:value (sci/eval-string* ctx source)}
    (catch Object e
      {:error (or (ex-message e) (str e))})))

(defn result-widget [{:keys [value error]}]
  (cond
    error
    (m/Text (str "SCI error: " error)
            .style (m/TextStyle .fontSize 14.0
                                .color m/Colors.red))

    (instance? m/Widget value)
    value

    (vector? value)
    (html/Html .data (hiccup->html value))

    :else
    (m/Text (pr-str value)
            .style (m/TextStyle .fontSize 14.0
                                .color m/Colors.black54))))

(defn make-ctx []
  (let [Text (fn [data & {:keys [style textAlign]}]
               (m/Text (if (nil? data) "" (str data))
                       .textAlign textAlign
                       .style style))
        TextStyle (fn [& {:keys [fontSize fontWeight color]}]
                    (m/TextStyle .fontSize fontSize
                                 .fontWeight fontWeight
                                 .color color))
        Column (fn [& {:keys [children mainAxisSize crossAxisAlignment]}]
                 (m/Column .mainAxisSize (or mainAxisSize m/MainAxisSize.min)
                           .crossAxisAlignment (or crossAxisAlignment m/CrossAxisAlignment.center)
                           .children (vec children)))
        Row (fn [& {:keys [children]}]
              (m/Row .children (vec children)))
        SizedBox (fn [& {:keys [height width child]}]
                   (m/SizedBox .height height .width width .child child))
        Container (fn [& {:keys [padding margin child]}]
                    (m/Container .padding padding
                                 .margin margin
                                 .child child))
        Image (fn [& {:keys [image height]}]
                (m/Image .image image .height height))
        AssetImage (fn [asset] (m/AssetImage asset))
        EdgeInsets.all (fn [value] (m/EdgeInsets.all value))
        EdgeInsets.symmetric (fn [& {:keys [horizontal vertical]}]
                               (m/EdgeInsets.symmetric .horizontal (or horizontal 0.0)
                                                       .vertical (or vertical 0.0)))
        ElevatedButton (fn [& {:keys [onPressed child]}]
                         (m/ElevatedButton .onPressed onPressed .child child))
        Checkbox (fn [& {:keys [value onChanged]}]
                   (m/Checkbox .value value .onChanged onChanged))
        Color (fn [value] (m/Color value))
        watch-fn (fn [a render] (f/widget :watch [_ a] (render @a)))]
    (sci/init
     {:namespaces
      {'clj-br.site
       {'model site-model
        'hiccup community-hiccup
        'html community-hiccup-widget
        'flutter community-flutter-widget}
       "package:flutter/material.dart"
       {'Text Text
        'TextStyle TextStyle
        'Column Column
        'Row Row
        'SizedBox SizedBox
        'Container Container
        'Image Image
        'AssetImage AssetImage
        'EdgeInsets.all EdgeInsets.all
        'EdgeInsets.symmetric EdgeInsets.symmetric
        'ElevatedButton ElevatedButton
        'Checkbox Checkbox
        'Color Color
        'TextAlign.center m/TextAlign.center
        'MainAxisSize.min m/MainAxisSize.min
        'CrossAxisAlignment.center m/CrossAxisAlignment.center
        'CrossAxisAlignment.stretch m/CrossAxisAlignment.stretch
        'FontWeight.bold m/FontWeight.bold
        'FontWeight.w600 m/FontWeight.w600
        'Colors.black54 m/Colors.black54
        'Colors.red m/Colors.red}
       'cljd.flutter
       {'watch (with-meta
                 (fn [_&form _&env a bindings & body]
                   (list watch-fn a (list* 'fn bindings body)))
                 {:macro true})}}})))

(defn card [child]
  (m/Card
   .elevation 0.0
   .color (m/Color 0xFFFFFFFF)
   .shape (m/RoundedRectangleBorder
           .borderRadius (m/BorderRadius.circular 8.0)
           .side (m/BorderSide .color (m/Color 0xFFE4E7EC)))
   .child
   (m/Padding
    .padding (m/EdgeInsets.all 18.0)
    .child child)))

(defn mode-button [active-mode label mode select-mode!]
  (let [active? (= active-mode mode)]
    (m/OutlinedButton
     .onPressed (fn [] (select-mode! mode))
     .style (m/OutlinedButton.styleFrom
             .backgroundColor (when active? (m/Color 0xFFE8F4FB)))
     .child (m/Text label))))

(defn sample-button [active-sample sample select-sample!]
  (let [active? (= active-sample sample)
        label (get-in samples [sample :label])]
    (m/OutlinedButton
     .onPressed (fn [] (select-sample! sample))
     .style (m/OutlinedButton.styleFrom
             .backgroundColor (when active? (m/Color 0xFFF2F4F7)))
     .child (m/Text label))))

(defn runtime-editor [active-mode active-sample select-mode! select-sample! controller result ctx]
  (card
   (m/Column
    .mainAxisSize m/MainAxisSize.min
    .crossAxisAlignment m/CrossAxisAlignment.stretch
    .children
    [(m/Text "Runtime SCI"
             .style (m/TextStyle .fontSize 14.0
                                 .fontWeight m/FontWeight.bold
                                 .color m/Colors.black54))
     (m/SizedBox .height 10.0)
     (m/Wrap
      .spacing 8.0
      .runSpacing 8.0
      .children
      [(mode-button active-mode "Hiccup/Reagent" :hiccup select-mode!)
       (mode-button active-mode "ClojureDart widget" :cljd select-mode!)])
     (m/SizedBox .height 10.0)
     (m/Text "Sample"
             .style (m/TextStyle .fontSize 13.0
                                 .fontWeight m/FontWeight.bold
                                 .color m/Colors.black54))
     (m/SizedBox .height 8.0)
     (m/Wrap
      .spacing 8.0
      .runSpacing 8.0
      .children
      (vec
       (for [sample sample-order]
         (sample-button active-sample sample select-sample!))))
     (m/SizedBox .height 12.0)
     (m/TextField
      .controller controller
      .minLines 8
      .maxLines 14
      .onChanged (fn [source]
                   (reset! result (eval-source ctx source)))
      .style (m/TextStyle .fontFamily "monospace"
                          .fontSize 13.0)
      .decoration
      (m/InputDecoration
       .border (m/OutlineInputBorder)
       .labelText (if (hiccup-mode? active-mode)
                    "SCI Hiccup/Reagent source"
                    "SCI ClojureDart widget source")))])))

(defn page-content [active-mode active-sample select-mode! select-sample! eval-result controller result ctx]
  (m/Column
   .mainAxisSize m/MainAxisSize.min
   .children
   [(card (result-widget eval-result))
    (m/SizedBox .height 18.0)
    (runtime-editor active-mode active-sample select-mode! select-sample! controller result ctx)]))

(defn page [active-mode active-sample select-mode! select-sample! eval-result controller result ctx]
  (m/MaterialApp
   .title "Clojure Brasil"
   .theme (m/ThemeData .useMaterial3 true
                       .scaffoldBackgroundColor (m/Color 0xFFF8FAFC)
                       .colorScheme (m/ColorScheme.fromSeed
                                     .seedColor (m/Color 0xFF1793D1)))
   .home
   (m/Scaffold
    .body
    (m/SafeArea
     .child
     (m/SingleChildScrollView
      .padding (m/EdgeInsets.symmetric .horizontal 18.0 .vertical 28.0)
      .child
      (m/Center
       .child
       (m/ConstrainedBox
        .constraints (m/BoxConstraints .maxWidth 760.0)
        .child (page-content active-mode active-sample select-mode! select-sample! eval-result controller result ctx))))))))

(defn main []
  (let [ctx (make-ctx)
        initial-source (source-for :site :hiccup)
        result (atom (eval-source ctx initial-source))
        controller (m/TextEditingController .text initial-source)
        active-mode (atom :hiccup)
        active-sample (atom :site)
        load-source! (fn [mode sample]
                       (let [source (source-for sample mode)]
                         (reset! active-mode mode)
                         (reset! active-sample sample)
                         (set! (.-text controller) source)
                         (reset! result (eval-source ctx source))))
        select-mode! (fn [mode] (load-source! mode @active-sample))
        select-sample! (fn [sample] (load-source! @active-mode sample))]
    (f/run
     (f/widget :watch [r result
                       mode active-mode
                       sample active-sample]
       (page mode sample select-mode! select-sample! r controller result ctx)))))
