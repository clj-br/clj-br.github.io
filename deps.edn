{:paths ["src"]
 :deps {io.pedestal/pedestal.service {:mvn/version "0.5.9"}
        io.pedestal/pedestal.jetty {:mvn/version "0.5.9"}
        hiccup/hiccup {:mvn/version "2.0.0-alpha2"}
        org.babashka/sci {:mvn/version "0.14.54"}}

 :cljd/opts {:kind :flutter
             :main repl.app}

 :aliases {:run {:main-opts ["--report" "stderr"
                             "-e" "((requiring-resolve,'clj-br.website))"]}
           :cljd {:extra-deps {tensegritics/clojuredart
                               {:git/url "https://github.com/tensegritics/ClojureDart.git"
                                :git/sha "79759559c2cf4280832e596949a81226db336014"}}
                  :main-opts ["-m" "cljd.build"]}}}
